[Unit]
Description=Agent Trading Multi-Timeframe (v3)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/trading-v3
ExecStart=/home/ubuntu/trading-v3/venv/bin/python /home/ubuntu/trading-v3/multi_tf_strategy.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
