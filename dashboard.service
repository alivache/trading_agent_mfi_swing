[Unit]
Description=Dashboard Gap Shadow + analist Claude (port 8080, read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/trading-v3
ExecStart=/home/ubuntu/trading-v3/venv/bin/python /home/ubuntu/trading-v3/dashboard_gap.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
