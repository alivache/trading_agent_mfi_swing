[Unit]
Description=Dashboard Trading Multi-Timeframe (v3, port 8080)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=liviu_anton
WorkingDirectory=/home/liviu_anton/trading-v3
ExecStart=/home/liviu_anton/trading/venv/bin/python3 /home/liviu_anton/trading-v3/dashboard.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
