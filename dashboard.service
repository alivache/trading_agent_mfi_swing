[Unit]
Description=Dashboard Trading Multi-Timeframe (v3, port 8080)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/trading-v3
ExecStart=/home/ubuntu/trading-v3/venv/bin/python /home/ubuntu/trading-v3/dashboard.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
